// Find Duplicates Using HashSet
int[] arr = {10, 20, 30, 20, 40, 10};
Set<Integer> set = new HashSet<>();
for (int num : arr) {
    if (!set.add(num)) {
        System.out.println("Duplicate: " + num);
    }
}
Output: Duplicate: 20  Duplicate: 10

// first repeated character
String str = "programming";
Set<Character> set = new HashSet<>();

for (char ch : str.toCharArray()) {
    if (!set.add(ch)) {
        System.out.println("First repeated: " + ch);
        break;
    }
}
Output: r

// Two Numbers With Target Sum
int[] arr = {2, 7, 11, 15};
int target = 9;

Set<Integer> set = new HashSet<>();

for (int num : arr) {

    int complement = target - num;

    if (set.contains(complement)) {
        System.out.println(complement + " + " + num + " = " + target);
        break;
    }

    set.add(num);
}
output:2 + 7 = 9


// Find Common Elements
int[] arr1 = {1, 2, 3, 4};
int[] arr2 = {3, 4, 5, 6};

Set<Integer> set = new HashSet<>();

for (int num : arr1) {
    set.add(num);
}

for (int num : arr2) {
    if (set.contains(num)) {
        System.out.println(num);
    }
}
OUTPUT: 3, 4

// FIND INTERSECTION
A = [1, 2, 2, 3]
B = [2, 2, 4]
OUTPUT: [2]

Set<Integer> set1 = new HashSet<>();

for (int num : arr1) {
    set1.add(num);
}

Set<Integer> result = new HashSet<>();
for (int num : arr2) {
    if (set1.contains(num)) {
        result.add(num);
    }
}
System.out.println(result);


// FIND Duplicate Numbers
int[] arr = {1, 3, 4, 2, 2};
Set<Integer> set = new HashSet<>();
for (int num : arr) {
    if (!set.add(num)) {
        System.out.println("Duplicate number: " + num);
    }
}
OUTPUT: 2









